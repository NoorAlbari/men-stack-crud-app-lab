<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>

    <%- include('./partials/navbar') %>
        <h1>Add Clothes To Sell</h1>
        <P>All Added Clothes MUST BE In A VERY GOOD CONDITION OR WILL BE RETURNED</P>

        <form action="/add-clothes" method="post">
            <label for="imageAdress">Image Adress :</label>
            <input name="imageAdress" id="imageAdress" type="text">
            <br>
            <br>

            <label for="itemName">Clothing Name :</label>
            <input name="itemName" id="itemName" type="text">
            <br>
            <br>

            <label for="forWomenOrMenOrKids">For :</label>
            <select name="forWomenOrMenOrKids" id="forWomenOrMenOrKids">
                <option value="Women">Women</option>
                <option value="Men">Men</option>
                <option value="Kids">Kids</option>
            </select>
            <br>
            <br>

            <label for="typeOfClothing">Type Of Clothing: </label>
            <select name="typeOfClothing" id="typeOfClothing">
                <option value="Dresses">Dresses</option>
                <option value="T-shirts">T-shirts</option>
                <option value="Pants">Pants</option>
                <option value="Two piece">Two piece</option>
            </select>
            <br>
            <br>

            <label for="price">Price :</label>
            <input name="price" id="price" type="number">
            <br>
            <br>

            <label for="sizing">Sizing :</label>
            <select name="sizing" id="sizing">

                <option value="S">S</option>
                <option value="M">M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
            </select>
            <br>
            <br>
            <button>ADD</button>
        </form>


</body>

</html>